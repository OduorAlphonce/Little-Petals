# Copy to .env and replace the placeholder credentials.
PORT=8080
DB_CONN_STR=postgres://postgres:postgres@localhost:5432/littlepetals?sslmode=disable

# Optional path overrides
STATIC_DIR=web/static
UPLOAD_DIR=web/static/uploads
# SONGS_UPLOAD_DIR=web/static/uploads/songs
# COVERS_UPLOAD_DIR=web/static/uploads/covers
# BOOKS_UPLOAD_DIR=web/static/uploads/books

# Optional connection pool tuning
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_PING_TIMEOUT=5s
